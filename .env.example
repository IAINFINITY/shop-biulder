# ============================================================
# Supabase — projeto Clinic+ B2B
# ============================================================
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ACCESS_TOKEN="your-access-token"

# Pooler (transações) e conexão direta (migrations/scripts)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# ============================================================
# Proxsis ProManager API (used by /api/proxis-order serverless function)
# ============================================================
# Base sem endpoint no final; o código chama ex.: .../TSMApi/"ObterItens"
PROXSIS_BASE_URL="http://177.38.10.218:8082/datasnap/rest/TSMApi"
PROXSIS_USER="your-proxsis-user"
PROXSIS_PASSWORD="your-proxsis-password"
PROXSIS_FILIAL="5"
PROXSIS_HEALTH_FILIAL="2"
# Pedido (SalvarPedidoVenda) - filial B2B padrão
PROXSIS_OIN_ID="48"
# Tabela comercial padrão para cliente novo sem tabela própria
PROXSIS_TPR_ID_DEFAULT="8728"
PROXSIS_CPA_ID="3"
PROXSIS_TTI_ID="7"
PROXSIS_POR_ID="1"
# Marcador no pedido Proxis (doc_marcador) para controle interno de pedidos do site B2B
PROXSIS_DOC_MARCADOR="PEDIDO B2B"
# Endereço padrão ao criar cliente (SalvarPedidoVenda exige endereço com mun_id válido)
PROXSIS_DEFAULT_MUN_ID="5555"
PROXSIS_DEFAULT_CEP="89820000"
PROXSIS_DEFAULT_EST_SIGLA="SC"
# API SalvarPedidoVenda - pes_id_ven (rodízio). Cleudenise 2871, Rafaela 3216, Kassia 2880,
# Shirley 7798, Janete 7057, Ana Paula 6437, Bruno 7318, Evandro 2365, Gildean 2370.
PROXIS_REP_PES_IDS="2871,3216,2880,7798,7057,6437,7318,2365,2370"
# Exportação .txt Proxis - coluna Rep (mesmos IDs).
VITE_PROXIS_IMPORT_REP="2871,3216,2880,7798,7057,6437,7318,2365,2370"

# Sincronização de tabelas de preço (/api/sync-price-tables, scripts/sync-price-tables.mjs)
PRICING_SYNC_SECRET="your-pricing-sync-secret"

# Dev: aceita CNPJ só com dígitos válidos, sem consultar Brasil API (cadastro/pedido)
VITE_SKIP_BRASIL_CNPJ_CHECK="true"

# ============================================================
# Bitrix24 CRM
# ============================================================
BITRIX_WEBHOOK_BASE_URL="https://seu-portal.bitrix24.com.br/rest/1/seu-webhook/"
BITRIX_PIPELINE_ID=""
BITRIX_STAGE_ID=""
BITRIX_RESPONSIBLE_ID=""
BITRIX_CURRENCY_ID="BRL"

# CNPJ mestre da Clinic+ para vinculação de funcionários (apenas dígitos)
VITE_CLINIC_MASTER_CNPJ="04163851000106"

# ============================================================
# Webhooks
# ============================================================
# Frontend webhook para sincronização de pedidos
VITE_ORDER_WEBHOOK_URL="https://webhooks-n8n.iainfinity.app/webhook/novo-carrinho"
# n8n webhook base URL (used by /api/proxis-order, /api/proxis-customer)
N8N_WEBHOOK_BASE_URL="https://webhooks-n8n.iainfinity.app/webhook"
