# ============================================================
# Supabase — projeto Clinic+ B2B
# ============================================================
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Usada pelas rotas /api/* para validar o token do chamador e recalcular preço.
# Sem ela as rotas respondem 503. Nunca expor no front (não usar prefixo VITE_).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ACCESS_TOKEN="your-access-token"

# Preço do pedido resolvido no servidor.
# Vazio/0 = modo sombra: calcula, registra divergência no log e envia o preço do
#           navegador. É o padrão até os logs serem conferidos.
# 1       = o preço do servidor passa a valer no pedido enviado ao Proxis.
PRICING_ENFORCE_SERVER_PRICE=""

# Pooler (transações) e conexão direta (migrations/scripts)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# ============================================================
# Proxsis ProManager API (used by /api/proxis-order serverless function)
# ============================================================
# Base sem endpoint no final; o código chama ex.: .../TSMApi/"ObterItens"
PROXSIS_BASE_URL="http://177.38.10.218:8082/datasnap/rest/TSMApi"
PROXSIS_USER="your-proxsis-user"
PROXSIS_PASSWORD="your-proxsis-password"
PROXSIS_FILIAL="5"
PROXSIS_HEALTH_FILIAL="2"
# Pedido (SalvarPedidoVenda) - filial B2B padrão
PROXSIS_OIN_ID="48"
# Tabela comercial padrão para cliente novo sem tabela própria
PROXSIS_TPR_ID_DEFAULT="8728"
PROXSIS_CPA_ID="3"
PROXSIS_TTI_ID="7"
PROXSIS_POR_ID="1"
# Marcador no pedido Proxis (doc_marcador) para controle interno de pedidos do site B2B
PROXSIS_DOC_MARCADOR="PEDIDO B2B"
# Endereço padrão ao criar cliente (SalvarPedidoVenda exige endereço com mun_id válido)
PROXSIS_DEFAULT_MUN_ID="5555"
PROXSIS_DEFAULT_CEP="89820000"
PROXSIS_DEFAULT_EST_SIGLA="SC"
# API SalvarPedidoVenda - pes_id_ven (rodízio). Cleudenise 2871, Rafaela 3216, Kassia 2880,
# Shirley 7798, Janete 7057, Ana Paula 6437, Bruno 7318, Evandro 2365, Gildean 2370.
PROXIS_REP_PES_IDS="2871,3216,2880,7798,7057,6437,7318,2365,2370"

# Sincronização de tabelas de preço (/api/sync-price-tables, scripts/sync-price-tables.mjs)
PRICING_SYNC_SECRET="your-pricing-sync-secret"

# Dev: aceita CNPJ só com dígitos válidos, sem consultar Brasil API (cadastro/pedido)
VITE_SKIP_BRASIL_CNPJ_CHECK="true"

# ============================================================
# Bitrix24 CRM
# ============================================================
BITRIX_WEBHOOK_BASE_URL="https://seu-portal.bitrix24.com.br/rest/1/seu-webhook/"
BITRIX_PIPELINE_ID=""
BITRIX_STAGE_ID=""
BITRIX_RESPONSIBLE_ID=""
BITRIX_CURRENCY_ID="BRL"

# CNPJ mestre da Clinic+ para vinculação de funcionários (apenas dígitos)
VITE_CLINIC_MASTER_CNPJ="04163851000106"

# ============================================================
# Webhooks
# ============================================================
# Frontend webhook para sincronização de pedidos
VITE_ORDER_WEBHOOK_URL="https://webhooks-n8n.iainfinity.app/webhook/novo-carrinho"
# n8n webhook base URL (used by /api/proxis-order, /api/proxis-customer)
N8N_WEBHOOK_BASE_URL="https://webhooks-n8n.iainfinity.app/webhook"

# --- Resumo de produto por IA (rota /api/resumo-produto) ---
# Sem OPENAI_API_KEY a rota responde 503 e o botao "Gerar com IA" avisa; o resto
# do painel e da loja seguem funcionando, e produto sem resumo cai no recorte da
# descricao. Ou seja: a ausencia da chave desliga a funcionalidade, nao o site.
OPENAI_API_KEY="sk-..."
# Modelo usado. OPENAI_RESUMO_MODEL tem prioridade; MODEL_NAME e o que ja existia
# no ambiente. Sem nenhum dos dois, cai em gpt-5.4-mini.
MODEL_NAME="gpt-5.4-mini"
# OPENAI_RESUMO_MODEL=""
OPENAI_TIMEOUT_SECONDS="60"

# --- MFA obrigatorio no painel (§11 do padrao de autenticacao) ---
# Vazio = MODO SOMBRA: as rotas administrativas respondem normalmente e cada
# acesso sem segundo fator vira um `console.warn` com `[auth] admin ... sem aal2`.
# Quando esse aviso parar de aparecer nos logs, todo administrador ja cadastrou o
# fator e da para ligar sem derrubar ninguem.
#
# MFA_ADMIN_OBRIGATORIO=1  -> rota administrativa exige token aal2 (403 sem ele).
#
# Enquanto estiver vazio, o item 3.2 do PERFIL-CLINIC-PLUS.md segue EM ABERTO:
# rodar em sombra e excecao temporaria, nao conformidade.
MFA_ADMIN_OBRIGATORIO=""

# Espelho de MFA_ADMIN_OBRIGATORIO para o navegador.
#
# So variavel com prefixo VITE_ chega ao bundle, entao a exigencia precisa
# existir nos dois lados. **As duas viram juntas:**
#
#   so esta ligada  -> painel exige o fator, mas a rota /api/* aceita sem ele
#   so a outra      -> rota recusa e o painel nem avisa: erro sem explicacao
#
# Vazio (padrao) = OPCIONAL. O painel abre para admin sem fator, e quem quiser
# ativar encontra o cadastro em Minha conta > Verificacao em duas etapas.
# Quem JA cadastrou continua passando pelo desafio — fator que nao e cobrado
# seria enfeite.
VITE_MFA_ADMIN_OBRIGATORIO=""

# --- WebAuthn / passkey (§12 do padrao de autenticacao) ---
# A §12 exige que "RP ID e origens permitidas DEVEM vir de configuracao
# explicita". Sem esta variavel o SDK usa o host atual, que funciona mas nao e
# configuracao explicita — e o item fica registrado como parcial no perfil.
#
# Use o DOMINIO, sem esquema e sem porta:
#   VITE_WEBAUTHN_RP_ID="catalogo-clinicmais.iainfinity.com.br"
#
# Atencao: mudar este valor invalida os passkeys ja cadastrados, porque a chave
# fica presa ao dominio em que foi criada. Definir antes de os primeiros usuarios
# cadastrarem e o momento barato; depois, cada pessoa precisa cadastrar de novo.
VITE_WEBAUTHN_RP_ID=""

# Passkey ligado? (vazio = nao)
#
# Nao adianta ligar aqui sozinho: o recurso precisa estar habilitado no projeto
# Supabase, e em 08/08 **nao da**. A propria Management API recusa:
#
#   PATCH /config/auth  ->  422
#   {"message":"Enabling of MFA with WebAuthn not currently supported"}
#
# Com o recurso desligado no servidor, `mfa.webauthn.register` responde
# `MFA enroll is disabled for WebAuthn`. Por isso o botao "Usar biometria ou
# chave de seguranca" fica escondido — ver `suportaPasskey` em `useMfa.ts`.
#
# Para ligar quando o Supabase liberar, na ordem:
#   1. habilitar WebAuthn no projeto (painel ou API, o que passar a funcionar)
#   2. definir VITE_WEBAUTHN_RP_ID acima
#   3. VITE_PASSKEY_HABILITADO="1"
#
# Ate la o TOTP e o unico segundo fator, e ele funciona.
VITE_PASSKEY_HABILITADO=""
